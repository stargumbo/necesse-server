# Networking
SERVER_PORT=14159

# World & access
WORLD_NAME=MyWorld
SERVER_PASSWORD=
# Or point at a file (e.g. a Docker secret); takes precedence over SERVER_PASSWORD.
SERVER_PASSWORD_FILE=
SERVER_SLOTS=10
SERVER_OWNER=
SERVER_MOTD=Necesse Dedicated Server

# Gameplay
PAUSE_WHEN_EMPTY=0
GIVE_CLIENTS_POWER=0

# Server behavior
ENABLE_LOGGING=1
ZIP_SAVES=1
SERVER_LANGUAGE=en
MAX_CLIENT_LATENCY=
SETTINGS_FILE=
BIND_IP=

# Storage options
LOCAL_DIR=0
DATA_DIR=
LOGS_DIR=

# Steam Workshop mods. Recommended: one public Workshop collection id; its items are resolved at
# every container start (no Steam login), fetched anonymously and kept as ws-<id>-*.jar in
# data/mods. Edit the collection in the Steam client, then restart the container. Blank = off.
MODS_COLLECTION=
# Or/and an explicit comma-separated list of item ids (union with the collection).
MODS_WORKSHOP=
# true (default): a failed download stops the container instead of starting with a partial mod set.
MODS_FAIL_FAST=true

# Lifecycle
UPDATE_ON_START=true
AUTO_UPDATE_INTERVAL_MINUTES=60
IMAGE_TAG=latest
JAVA_OPTS=
PUID=
PGID=
