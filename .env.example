# Networking
SERVER_PORT=14159

# World & access
WORLD_NAME=MyWorld
SERVER_PASSWORD=
# Or point at a file (e.g. a Docker secret); takes precedence over SERVER_PASSWORD.
SERVER_PASSWORD_FILE=
SERVER_SLOTS=10
SERVER_OWNER=
SERVER_MOTD=Necesse Dedicated Server

# Gameplay
PAUSE_WHEN_EMPTY=0
GIVE_CLIENTS_POWER=0

# Server behavior
ENABLE_LOGGING=1
ZIP_SAVES=1
SERVER_LANGUAGE=en
MAX_CLIENT_LATENCY=
SETTINGS_FILE=
BIND_IP=

# Storage options
LOCAL_DIR=0
DATA_DIR=
LOGS_DIR=

# Steam Workshop mods: comma-separated item ids, fetched anonymously at container start and kept
# as ws-<id>-*.jar in data/mods. Players must subscribe to the same ids themselves. Blank = off.
MODS_WORKSHOP=
# true (default): a failed download stops the container instead of starting with a partial mod set.
MODS_FAIL_FAST=true

# Lifecycle
UPDATE_ON_START=true
AUTO_UPDATE_INTERVAL_MINUTES=60
IMAGE_TAG=latest
JAVA_OPTS=
PUID=
PGID=
